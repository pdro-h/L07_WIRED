<!-- Jenkins Audit Trail -->
<!-- Ex: May 19, 2026 11:28:04,509 PM;/script by dragonfly from 192.168.69.128 -->
<!-- Jenkins Audit Trail - URL actions -->
<decoder name="jenkins-audit-trail">
    <prematch>by \S+ from \d+\.\d+\.\d+\.\d+</prematch>
    <regex>^(.+);(\S+) by (\S+) from (\S+)$</regex>
    <order>extra_data, url, srcuser, srcip</order>
</decoder>

<!-- Jenkins Audit Trail - Groovy Script Console -->
<decoder name="jenkins-audit-groovy">
  <prematch>groovy script was executed by user</prematch>
  <regex offset="after_prematch">user '([^']+)'.*The executed script:\s*(.*)</regex>
  <order>user, script</order>
</decoder>
